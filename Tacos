<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tacos El Sabor</title>

  <style>
    body{
      margin: 0;
      font-family: Arial, sans-serif;
      background-color: #fff8f0;
      text-align: center;
    }

    header{
      background-color: #d62828;
      color: white;
      padding: 25px;
    }

    nav{
      background-color: #f77f00;
      padding: 10px;
    }

    nav a{
      color: white;
      text-decoration: none;
      margin: 15px;
      font-weight: bold;
    }

    .contenido{
      padding: 30px;
    }

    h2{
      color: #d62828;
    }

    p{
      font-size: 18px;
      color: #333;
    }

    img{
      width: 300px;
      border-radius: 15px;
      margin-top: 20px;
      box-shadow: 0px 4px 10px rgba(0,0,0,0.3);
    }

    .menu{
      background-color: white;
      margin: 30px auto;
      padding: 20px;
      width: 80%;
      border-radius: 15px;
      box-shadow: 0px 4px 10px rgba(0,0,0,0.1);
    }

    ul{
      list-style: none;
      padding: 0;
    }

    li{
      padding: 10px;
      font-size: 18px;
    }

    button{
      background-color: #d62828;
      color: white;
      border: none;
      padding: 12px 25px;
      font-size: 16px;
      border-radius: 10px;
      cursor: pointer;
      margin-top: 20px;
    }

    button:hover{
      background-color: #9d0208;
    }

    footer{
      background-color: #f77f00;
      color: white;
      padding: 15px;
      margin-top: 30px;
    }
  </style>
</head>

<body>

  <header>
    <h1>🌮 Tacos El Sabor 🌮</h1>
    <p>Los mejores tacos de la ciudad</p>
  </header>

  <nav>
    <a href="#">Inicio</a>
    <a href="#">Menú</a>
    <a href="#">Promociones</a>
    <a href="#">Contacto</a>
  </nav>

  <div class="contenido">

    <h2>Bienvenidos</h2>

    <p>
      En Tacos El Sabor preparamos tacos deliciosos con ingredientes frescos,
      tortillas calientes y las mejores salsas mexicanas.
    </p>

    <img src="https://images.unsplash.com/photo-1613514785940-daed07799d9b?q=80&w=1200&auto=format&fit=crop" alt="Tacos mexicanos">

    <div class="menu">

      <h2>Nuestro Menú</h2>

      <ul>
        <li>🌮 Taco de carne - $2.50</li>
        <li>🌮 Taco de pollo - $2.00</li>
        <li>🌮 Taco al pastor - $3.00</li>
        <li>🥤 Bebidas - $1.50</li>
      </ul>

    </div>

    <button onclick="mostrarMensaje()">
      Ver promoción
    </button>

  </div>

  <footer>
    <p>📍 Guayaquil, Ecuador | 📞 0999999999</p>
  </footer>

  <script>
    function mostrarMensaje(){
      alert("🎉 Promoción: ¡Compra 3 tacos y recibe una bebida gratis!");
    }
  </script>

</body>
</html>
